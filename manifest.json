{
  "manifest_version": 3,
  "name": "GFG Course Auto-Advancer",
  "version": "5.7.0",
  "description": "Automatically advances GeeksforGeeks course videos at 2.0x speed, skipping completed lessons and quizzes, with background execution across virtual desktops.",
  "permissions": [
    "alarms",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.geeksforgeeks.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.geeksforgeeks.org/batch/*",
        "*://geeksforgeeks.org/batch/*"
      ],
      "js": ["content_main.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.geeksforgeeks.org/batch/*",
        "*://geeksforgeeks.org/batch/*"
      ],
      "js": ["content_isolated.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
